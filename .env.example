# Copy to .env and fill in. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
# Leave unset to use local SQLite; set for hosted Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
# Set to true only when serving over HTTPS
FORCE_HTTPS_COOKIES=false
